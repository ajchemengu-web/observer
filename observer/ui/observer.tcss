Screen {
    background: $background;
}

#app-grid {
    layout: horizontal;
    height: 1fr;
}

#sidebar {
    width: 26;
    background: #0d1117;
    border-right: heavy #30363d;
    padding: 1;
}

#sidebar .nav-title {
    color: #58a6ff;
    text-style: bold;
    padding-bottom: 1;
}

Button.nav {
    width: 100%;
    min-height: 1;
    background: #161b22;
    color: #c9d1d9;
    border: none;
    border-left: thick #30363d;
}

Button.nav:hover {
    background: #21262d;
    border-left: thick #58a6ff;
}

Button.nav.-active {
    background: #1f6feb;
    color: white;
    border-left: thick #58a6ff;
}

#content {
    padding: 1 2;
    width: 1fr;
}

.panel-title {
    text-style: bold;
    color: #58a6ff;
    padding-bottom: 1;
}

.hint {
    color: #8b949e;
}

#stats-row {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;
}

.stat-box {
    width: 1fr;
    height: 5;
    margin-right: 1;
    border: round #30363d;
    content-align: center middle;
    text-style: bold;
}

.stat-info { color: cyan; }
.stat-low { color: green; }
.stat-medium { color: yellow; }
.stat-high { color: orange; }
.stat-critical { color: red; }

#dashboard-top {
    height: auto;
    layout: horizontal;
}

#dashboard-left {
    width: 1fr;
    height: auto;
}

#orbit-panel {
    width: 37;
    height: auto;
    margin-left: 2;
    border: round #30363d;
    padding: 0 1;
    align: center middle;
}

.orbit-title {
    text-style: bold;
    color: #58a6ff;
    text-align: center;
    width: 100%;
}

DataTable {
    height: 1fr;
}

Log {
    height: 10;
    border: round #30363d;
    background: #0d1117;
}

Input {
    margin-bottom: 1;
}
